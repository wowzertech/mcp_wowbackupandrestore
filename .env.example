# Copy to .env and fill in. Everything here maps 1:1 to src/s3_mcp/settings.py.

# --- Public identity of this server ------------------------------------------
# Must match the Auth0 API Identifier exactly — it is the `aud` claim we validate.
PUBLIC_URL=https://mcp.example.com
# Path the protocol is served on. "/" makes the bare host the whole endpoint
# (clients paste https://mcp.example.com); "/mcp" keeps a path.
MCP_PATH=/

# --- Auth0 --------------------------------------------------------------------
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://mcp.example.com
REQUIRE_EMAIL_VERIFIED=true

# --- Entitlements -------------------------------------------------------------
# "portal_api" (recommended) or "postgres"
ENTITLEMENT_BACKEND=portal_api

# portal_api backend
ENTITLEMENT_API_URL=https://api.example.com/internal
ENTITLEMENT_API_TOKEN=
ENTITLEMENT_API_TIMEOUT=3.0

# postgres backend (only if ENTITLEMENT_BACKEND=postgres)
DATABASE_URL=

# Revocation lag in seconds: a cancelled subscription keeps working this long.
ENTITLEMENT_CACHE_TTL=300

# --- S3 -----------------------------------------------------------------------
# Layout: s3://{bucket}/{email}/{organisation}/{backup_date}/{file}
#
# Backups live in the region their organisation belongs to, so the bucket is
# chosen per organisation from the country code on its record. S3_BUCKET and
# AWS_REGION are only the fallback for a country code that is not listed below.
S3_BUCKET=example-backups-beta
AWS_REGION=us-east-1

S3_BUCKET_NAME_CA=example-backups-beta
S3_BUCKET_NAME_AU=example-backups-au
S3_BUCKET_NAME_NZ=example-backups-nz
S3_BUCKET_NAME_US=example-backups-us
S3_BUCKET_NAME_UK=example-backups
S3_BUCKET_NAME_GB=example-backups

AWS_REGION_CA=ca-central-1
AWS_REGION_AU=ap-southeast-2
AWS_REGION_NZ=ap-southeast-6
AWS_REGION_US=us-east-1
AWS_REGION_UK=eu-west-2
AWS_REGION_GB=eu-west-2

# Named profile from ~/.aws/credentials (dev only; use an execution role in prod)
AWS_PROFILE=

# Optional but recommended in production: role assumed per request with a
# session policy scoped to the caller's own prefix. Leave empty in dev.
S3_ASSUME_ROLE_ARN=

# --- Guard rails --------------------------------------------------------------
MAX_OBJECT_BYTES=209715200
MAX_PREVIEW_ROWS=100
